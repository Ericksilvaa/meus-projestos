    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^7.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
